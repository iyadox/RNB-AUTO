# ─────────────────────────────────────────────────────────────────────────────
# RNB AUTO — variables d'environnement
# Copiez ce fichier en « .env » pour le développement local (ou pour Docker).
# En production (Vercel, serveur…), renseignez ces variables chez l'hébergeur.
# Ne mettez JAMAIS ces valeurs dans le code ni sur GitHub.
# Guide complet : docs/08-installation-et-deploiement.md
# ─────────────────────────────────────────────────────────────────────────────

# Base de données.
# - Local, sans rien installer : pglite:./.data/pglite (base créée et remplie automatiquement)
# - Production : l'adresse PostgreSQL fournie par Neon, Supabase, etc. (postgres://…)
#   Sur Vercel, la variable est ajoutée automatiquement quand vous reliez une base (Storage).
DATABASE_URL=pglite:./.data/pglite

# Adresse publique du site (sans / à la fin). Sert aux liens, aux emails et au référencement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Code demandé pour créer le premier compte administrateur sur /admin/installation.
# OBLIGATOIRE en production : choisissez une longue phrase secrète. Facultatif en local.
SETUP_TOKEN=

# Secret de la tâche d'entretien quotidienne (/api/maintenance) : longue chaîne aléatoire.
# Sur Vercel, la tâche planifiée l'envoie automatiquement. Sans lui, l'entretien se fait
# quand même lors des visites de l'administration (au plus toutes les 6 heures).
CRON_SECRET=

# Calcul des trajets et des adresses : « auto » utilise les services publics gratuits (IGN, OSRM).
# « simulation » calcule des distances approximatives SANS internet : uniquement pour les essais.
GEO_PROVIDER=auto
# Facultatif : clé OpenRouteService (gratuite) pour un service de secours supplémentaire.
OPENROUTESERVICE_API_KEY=

# Emails des nouvelles demandes (facultatif) : clé Resend + adresse d'expédition d'un domaine vérifié.
RESEND_API_KEY=
EMAIL_FROM=

# Facultatif, lu uniquement à la toute première installation pour pré-remplir l'entreprise.
SEED_COMPANY_PHONE=
SEED_COMPANY_WHATSAPP=
SEED_COMPANY_EMAIL=
SEED_COMPANY_AVAILABILITY=

# Docker uniquement (docker-compose.yml) : mot de passe de la base PostgreSQL du conteneur.
POSTGRES_PASSWORD=

# Réglages techniques rarement utiles :
# DATABASE_POOL_MAX=5          nombre de connexions simultanées à PostgreSQL
# ALLOW_GEO_SIMULATION=1       autorise GEO_PROVIDER=simulation en production (déconseillé)
